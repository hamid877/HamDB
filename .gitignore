# Build directories
build/
cmake-build-*/
out/

# CMake generated files (scoped to build dirs — root Makefile is tracked)
CMakeCache.txt
CMakeFiles/
build/Makefile
cmake_install.cmake
compile_commands.json

# Object files
*.o
*.obj
*.so
*.a
*.dll
*.exe

# IDE — track .vscode/settings.json (shared config); ignore personal overrides
.vscode/*.json.user
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
