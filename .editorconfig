root = true

# ── All files ──────────────────────────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true

# ── C++ source and headers ────────────────────────────────────────────────────
[*.{cpp,hpp,h,cc,cxx,hh}]
indent_style = space
indent_size  = 4

# ── CMake files ───────────────────────────────────────────────────────────────
[CMakeLists.txt]
indent_style = space
indent_size  = 4

[*.cmake]
indent_style = space
indent_size  = 4

# ── YAML / JSON / Markdown ────────────────────────────────────────────────────
[*.{yml,yaml,json}]
indent_style = space
indent_size  = 2

[*.md]
trim_trailing_whitespace = false
indent_style             = space
indent_size              = 2

# ── Shell scripts ─────────────────────────────────────────────────────────────
[*.sh]
indent_style = space
indent_size  = 4
